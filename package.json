{
  "name": "camera-recorder",
  "version": "1.2.0",
  "private": true,
  "description": "Desktop camera recorder for ResearchDrive",
  "main": "main.js",
  "author": "UW-Madison Niedenthal Lab",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --dir --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "js-yaml": "5.4.2"
  },
  "build": {
    "appId": "edu.wisc.niedenthal.camera-recorder",
    "productName": "SCS Camera-App",
    "icon": "assets/icon.png",
    "asar": true,
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "storage.js",
      "updater.js",
      "assets/icon.png",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "aditya-harsh11",
      "repo": "camera-app"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "category": "public.app-category.video",
      "extendInfo": {
        "NSCameraUsageDescription": "SCS Camera-App uses the camera to record video.",
        "NSMicrophoneUsageDescription": "SCS Camera-App uses the microphone to record audio."
      }
    },
    "nsis": {
      "artifactName": "SCS-Camera-App-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "SCS-Camera-App-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
