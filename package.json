{
  "name": "camera-recorder",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop camera recorder for ResearchDrive",
  "main": "main.js",
  "author": "UW-Madison Niedenthal Lab",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "edu.wisc.niedenthal.camera-recorder",
    "productName": "Camera Recorder",
    "asar": true,
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "storage.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
